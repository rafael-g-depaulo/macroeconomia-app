{
  "name": "client",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/client/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project client --web",
  "targets": {
    "web": {
      "continuous": true,
      "options": {
        "cwd": "apps/client",
        "command": "vite"
      },
      "metadata": {
        "technologies": ["vite"],
        "description": "Starts Vite dev server",
        "help": {
          "command": "yarn vite --help",
          "example": {
            "options": {
              "port": 3000
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "configurations": {},
      "parallelism": true,
      "dependsOn": ["strapi-app:start"]
    },
    "build": {
      "options": {
        "cwd": "apps/client",
        "command": "vite build"
      },
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "default",
        "^default",
        {
          "externalDependencies": ["vite"]
        }
      ],
      "outputs": ["{workspaceRoot}/dist/apps/client"],
      "metadata": {
        "technologies": ["vite"],
        "description": "Run Vite build",
        "help": {
          "command": "yarn vite build --help",
          "example": {
            "options": {
              "sourcemap": true,
              "manifest": "manifest.json"
            }
          }
        }
      },
      "executor": "nx:run-commands",
      "configurations": {},
      "parallelism": true
    }
  }
}
